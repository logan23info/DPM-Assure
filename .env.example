# Application
APP_BASE_URL=https://assure.example.com
DATABASE_URL=postgres://runtime_user:change-me@db.example.com:5432/dpm_assure?sslmode=require

# Email
RESEND_API_KEY=
AUTH_EMAIL_FROM=DPM-Assure <no-reply@example.com>

# Private evidence object storage (S3-compatible; bucket must not be public)
OBJECT_STORE_ENDPOINT=https://s3.example.com
OBJECT_STORE_REGION=auto
OBJECT_STORE_FORCE_PATH_STYLE=false
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_BUCKET=dpm-assure-evidence
OBJECT_STORE_UPLOAD_URL_TTL_SECONDS=600
OBJECT_STORE_DOWNLOAD_URL_TTL_SECONDS=300
EVIDENCE_MAX_UPLOAD_BYTES=52428800

# Advisory AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
